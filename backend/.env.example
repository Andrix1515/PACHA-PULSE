# Server-only configuration. Copy to backend/.env for local use.
# Never commit .env or prefix this key with VITE_.

# Google Gemini API configuration for AI Agricultural Assistant (Pacha)
# Obtain privately from Google AI Studio: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Copernicus Climate Data Store (CDS) API key for ERA5 raw bulk reanalysis.
# Register and obtain key from: https://cds.climate.copernicus.eu/how-to-api
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# Optional local cache override. Defaults to an ephemeral /tmp or local data/cache/observations.sqlite.
# CLIMATE_CACHE_PATH=
