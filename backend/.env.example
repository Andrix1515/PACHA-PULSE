# Server-only configuration. Copy to backend/.env for local use.
# Never commit .env or prefix this key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local cache override. Vercel defaults to an ephemeral /tmp cache.
# CLIMATE_CACHE_PATH=
# Optional HTTPS Photon-compatible search endpoint for your own provider.
# Public demo searches are explicit, cached and bounded; no autocomplete.
# PHOTON_SEARCH_URL=https://photon.komoot.io/api/
